{
  "name": "fetch-news",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "npm run typecheck && vite build && tsup server/index.ts server/cli.ts --format esm --out-dir dist/server --clean --external mysql2",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server/index.js",
    "db:migrate": "node --import tsx server/cli.ts migrate",
    "admin:create": "node --import tsx server/cli.ts admin",
    "test": "node --import tsx --test tests/unit.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 tests/integration.test.ts",
    "test:browser": "node --import tsx tests/browser-smoke.ts",
    "format": "prettier --write server client tests vite.config.ts",
    "test:runtime": "node --import tsx tests/runtime-smoke.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^6.1.1",
    "antd": "^5.27.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.0",
    "fastify": "^5.6.0",
    "mysql2": "^3.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
