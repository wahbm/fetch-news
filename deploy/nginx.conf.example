# Include this snippet in an existing HTTPS server block after replacing
# GITHUB_LOGIN, project root and the collision-checked local port.
# APP_BASE_PATH and Vite build base must both be /GITHUB_LOGIN/fetch-news/.
location = /GITHUB_LOGIN/fetch-news {
    return 308 /GITHUB_LOGIN/fetch-news/;
}
location ^~ /GITHUB_LOGIN/fetch-news/assets/ {
    alias /srv/fetch-news/current/dist/client/assets/;
    expires 1h;
    add_header X-Content-Type-Options nosniff always;
}
location /GITHUB_LOGIN/fetch-news/ {
    alias /srv/fetch-news/current/dist/client/;
    index index.html;
    try_files $uri $uri/ /GITHUB_LOGIN/fetch-news/index.html;
    add_header Cache-Control "no-cache";
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
}
location ^~ /GITHUB_LOGIN/fetch-news/api/ {
    proxy_pass http://127.0.0.1:3107;
    proxy_set_header Host $host;
    # Replace, do not trust a forwarded value supplied by the public client.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    client_max_body_size 1m;
    proxy_read_timeout 30s;
    add_header Cache-Control "no-store" always;
}
location = /GITHUB_LOGIN/fetch-news/health {
    proxy_pass http://127.0.0.1:3107;
    proxy_set_header Host $host;
}
